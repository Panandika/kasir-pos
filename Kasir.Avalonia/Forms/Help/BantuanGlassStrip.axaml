<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             xmlns:vm="clr-namespace:Kasir.Avalonia.Forms.Help"
             x:Class="Kasir.Avalonia.Forms.Help.BantuanGlassStrip"
             x:DataType="vm:BantuanViewModel"
             Focusable="True"
             KeyDown="OnKeyDown">

  <UserControl.Styles>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #2D000000"/>
    </Style>
    <Style Selector="Border.modePillTanya">
      <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="Border.modePillLapor">
      <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="TextBlock.kbd">
      <Setter Property="FontFamily" Value="ui-monospace, Consolas, monospace"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.kbd">
      <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="5,1"/>
    </Style>
  </UserControl.Styles>

  <!-- Full-canvas dim scrim (catches Esc / click-outside) plus the strip + above-card -->
  <Grid Name="RootGrid" Background="#01000000">

    <!-- SCRIM: invisible click-catcher -->
    <Border Background="Transparent" PointerPressed="OnScrimPressed"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

    <!-- ABOVE CARD: floating content above the strip (answer, chips, etc.) -->
    <Border Name="AboveCard" Classes="glass"
            Width="560" MinHeight="60"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,86"
            IsVisible="False"
            Padding="14,12">
      <StackPanel Name="AboveContent" Spacing="8"/>
    </Border>

    <!-- STRIP: the 44px floating bar at bottom-center -->
    <Border Name="Strip" Classes="glass"
            Width="560" Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,32">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="10,0">
        <!-- offline sync badge (col 0) -->
        <Border Name="OfflineBadge" Grid.Column="0"
                Background="{DynamicResource WarningBrush}"
                CornerRadius="999" Padding="8,2"
                IsVisible="False" Margin="0,0,8,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Ellipse Width="5" Height="5" Fill="White"/>
            <TextBlock Text="Offline" FontSize="10" FontWeight="SemiBold"
                       Foreground="White"/>
          </StackPanel>
        </Border>

        <!-- mode pill (col 1) -->
        <Border Name="ModePill" Grid.Column="1" Classes="modePillTanya"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <lucide:LucideIcon Name="ModeIcon" Kind="Sparkles" Size="11"
                               Foreground="White"/>
            <TextBlock Name="ModeLabel" Text="TANYA"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="White"/>
            <TextBlock Text="Shift+Tab" Classes="kbd" Foreground="#E0FFFFFF"
                       Margin="2,0,0,0"/>
          </StackPanel>
        </Border>

        <!-- input (col 2) -->
        <TextBox Name="InputBox" Grid.Column="2"
                 Margin="8,0"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="13"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 PlaceholderText="Tanya, atau Shift+Tab untuk lapor"
                 KeyDown="OnInputKeyDown"
                 TextChanged="OnInputChanged"/>

        <!-- enter hint (col 3) -->
        <StackPanel Name="EnterHint" Grid.Column="3" Orientation="Horizontal"
                    Spacing="4" VerticalAlignment="Center" IsVisible="False"
                    Margin="0,0,8,0">
          <Border Classes="kbd"><TextBlock Text="↵" Classes="kbd"/></Border>
          <TextBlock Text="kirim" FontSize="9"
                     Foreground="{DynamicResource FgSecondaryBrush}"/>
        </StackPanel>

        <!-- send button (col 4) -->
        <Button Name="SendButton" Grid.Column="4"
                Width="28" Height="28"
                Padding="0" Margin="0,0,8,0"
                Background="{DynamicResource BrandBrush}"
                Foreground="White"
                BorderThickness="0"
                CornerRadius="6"
                Click="OnSendClicked">
          <lucide:LucideIcon Name="SendIcon" Kind="ArrowRight" Size="13" Foreground="White"/>
        </Button>

        <!-- esc hint (col 5) -->
        <Border Grid.Column="5" Classes="kbd" VerticalAlignment="Center">
          <TextBlock Text="Esc" Classes="kbd"/>
        </Border>
      </Grid>
    </Border>

    <!-- TOAST: top-right success notification (Sent state) -->
    <Border Name="SentToast" Classes="glass"
            Background="{DynamicResource Bg1Brush}"
            BorderBrush="{DynamicResource SuccessBrush}"
            BorderThickness="3,1,1,1"
            CornerRadius="6"
            Width="300" MinHeight="56"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,90"
            Padding="14,10"
            IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Background="{DynamicResource BgSelectedBrush}"
                CornerRadius="999" Width="22" Height="22">
          <lucide:LucideIcon Kind="Check" Size="13"
                             Foreground="{DynamicResource SuccessBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Name="ToastTitle"
                     Text="Laporan terkirim · #TKT-..."
                     FontWeight="SemiBold" FontSize="11"/>
          <TextBlock Text="IT akan menghubungi."
                     FontSize="10"
                     Foreground="{DynamicResource FgSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
